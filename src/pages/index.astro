---
import Base from '../layouts/Base.astro';
import { prompt, voiceSets, modes, loop, stages, outcomes, principles } from '../data/site';

interface Props { showPrinciples?: boolean; }
const { showPrinciples = true } = Astro.props;
---
<Base
  title="Wayfinding"
  description="Decide whether, where and how AI serves your mission, your relationships and your work."
>
  <header class="site-header wrap">
    <a class="brand" href="#top"><img src="/wayfinding-mark.svg" alt="" width="30" height="30" /><span>Wayfinding</span></a>
    <nav aria-label="Main navigation">
      <a href="#triangle">The Triangle</a>
      <a href="#exercise">How it works</a>
      <a href="#outcomes">Outcomes</a>
      <a class="nav-start" href="#start">Start with your agent →</a>
    </nav>
  </header>
  <div class="spectrum" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

  <main id="top">
    <section class="hero wrap" aria-labelledby="hero-heading">
      <div>
        <p class="eyebrow hero-eyebrow">For mission-driven teams</p>
        <h1 id="hero-heading">Clarity,<br /><em>not certainty.</em></h1>
      </div>
      <div class="hero-copy">
        <p class="hero-lede">Decide whether, where and how AI serves your mission, your relationships and your work.</p>
        <p class="body-copy">Every outcome is on the table, including less AI or none. A human facilitator leads; an authorised person decides. Agents assist, and ask before they act.</p>
        <div class="button-row">
          <a class="button button-primary" href="#start">Start with your agent</a>
          <a class="button button-outline" href="#facilitator">Work with a facilitator</a>
        </div>
      </div>
    </section>

    <section class="not-strip" aria-label="What this isn't">
      <div class="wrap not-items">
        <span class="eyebrow accent">What this isn't</span>
        <span>Not selling AI.</span>
        <span>Not an adoption push.</span>
        <span>Not a tool recommendation.</span>
      </div>
    </section>

    <section id="start" class="start-section panel" aria-labelledby="start-heading">
      <div class="wrap start-grid">
        <div class="stack">
          <p class="eyebrow accent">01 — Start</p>
          <h2 id="start-heading">Start with your agent</h2>
          <p class="section-intro">Copy this into your AI agent. It starts with a private interview about you, and it tells you what it will do before it does anything.</p>
          <ul class="benefits" aria-label="What you get">
            <li><span aria-hidden="true">→</span>Your first position: an interview run by your agent, written up as a short sensemaking document that shows where you stand today.</li>
            <li><span aria-hidden="true">→</span>A guide for interviewing a teammate, so you can compare positions and start making sense of AI together.</li>
            <li><span aria-hidden="true">→</span>It stays yours. Nothing is sent to Wayfinding; you decide what to keep and what to share.</li>
          </ul>
        </div>
        <div class="prompt-box">
          <div class="prompt-head"><span>paste into your agent</span><button id="copy" type="button">Copy</button></div>
          <pre id="prompt">{prompt}</pre>
          <a href="https://github.com/AI-Wayfinding/getting-started">Read the instructions first →</a>
        </div>
      </div>
      <div id="facilitator" class="wrap facilitator-wrap">
        <div class="facilitator-box">
          <div class="stack small-stack"><p class="eyebrow">Or start with a person</p><h3>Let us be your guide</h3></div>
          <div class="stack facilitator-copy"><p class="body-copy">No agent needed. A facilitator from one of our partner organisations can lead your team through listening, weighing options and a first decision.</p><a class="button button-primary" href="#partners">Meet the partners →</a></div>
        </div>
      </div>
    </section>

    <section id="triangle" class="triangle-section wrap" aria-labelledby="triangle-heading">
      <div class="stack">
        <p class="eyebrow accent">02 — Why</p>
        <h2 id="triangle-heading">Weigh every choice on three points</h2>
        <p class="section-intro">The Evaluation Triangle is both the reason to consider AI and the lens for judging it — before, during and after. Time savings alone are never enough.</p>
        <div class="dimensions">
          <div><span>A</span><div><h3>Mission &amp; Impact</h3><p>Does this serve what you're here to do, and who you serve?</p></div></div>
          <div><span>B</span><div><h3>Human Relationships &amp; Connection</h3><p>Don't put AI between your organisation and the people you serve.</p></div></div>
          <div><span>C</span><div><h3>Productivity &amp; Efficiency</h3><p>Choose augmentation over substitution, deliberately.</p></div></div>
        </div>
      </div>
      <div class="triangle-diagram" role="img" aria-label="Evaluation Triangle: A Mission, B Relationships, C Productivity, in balance">
        <svg viewBox="0 0 100 92" aria-hidden="true">
          <polygon points="50,6 94,84 6,84" fill="none" stroke="currentColor" stroke-width=".4"></polygon>
          <polygon points="50,30 73,72 27,72" fill="none" stroke="currentColor" stroke-width=".2" stroke-dasharray="1 1"></polygon>
          <circle cx="50" cy="58" r="1.4" fill="var(--accent)"></circle>
          <circle cx="50" cy="6" r="1.2" fill="currentColor"></circle>
          <circle cx="94" cy="84" r="1.2" fill="currentColor"></circle>
          <circle cx="6" cy="84" r="1.2" fill="currentColor"></circle>
        </svg>
        <span class="point-a">A · Mission</span><span class="point-c">C · Productivity</span><span class="point-b">B · Relationships</span><span class="point-balance">balance</span>
      </div>
    </section>

    <section id="exercise" class="exercise-section panel" aria-labelledby="exercise-heading">
      <div class="wrap exercise-content">
        <div class="section-heading split-heading">
          <div class="stack"><p class="eyebrow accent">03 — How</p><h2 id="exercise-heading">A practice, not a one-off</h2></div>
          <p class="body-copy">Wayfinding starts with listening and keeps going: working sessions on real tasks, learning from peers, and decisions that get reviewed.</p>
        </div>
        <div class="mode-grid">
          {modes.map((mode) => <div class="mode-card">
            <span class="mode-number">{mode.n}</span>
            <h3>{mode.title}</h3>
            <p>{mode.body}</p>
            <p class="mode-form">{mode.form}</p>
          </div>)}
        </div>
        <div class="process-grid">
          <div class="process-block">
            <h3 class="eyebrow">Every initiative runs the same loop</h3>
            <div class="loop-grid">{loop.map((step) => <div><h4>{step.t}</h4><p>{step.q}</p></div>)}</div>
            <p class="process-note">Start small, measure across all three points of the Triangle, then adapt or abandon.</p>
          </div>
          <div class="process-block">
            <h3 class="eyebrow">Organisations move at their own pace</h3>
            <div class="stage-list">{stages.map((stage) => <div class="stage"><span>{stage.n}</span><div><h4>{stage.t}</h4><p>{stage.d}</p></div></div>)}</div>
            <p class="process-note">Some teams stay at Build Fluency on purpose. Some move back. Neither is failure.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="voices" class="voices-section wrap" aria-labelledby="voices-heading">
      <div class="stack voices-intro">
        <p class="eyebrow accent">From the practice</p>
        <h2 id="voices-heading">Holding two things at once</h2>
        <p class="section-intro">What we've learned while listening, before anyone recommended a tool. Curious and cautious, rarely one or the other.</p>
      </div>
      <div class="voice-grid" data-voice-sets={JSON.stringify(voiceSets)}>
        {voiceSets.map((set) => <figure class="voice-card" tabindex="0" role="button" aria-label={`Advance ${set.tag} quote`}>
          <div class="voice-top"><span class="voice-tag">{set.tag}</span><span class="voice-dots" aria-hidden="true">{set.items.map((_, index) => <span class:list={['voice-dot', { active: index === 0 }]}></span>)}</span></div>
          <div class="voice-quote" aria-live="polite" aria-atomic="true"><blockquote>“{set.items[0].q}”</blockquote><figcaption>{set.items[0].who}</figcaption></div>
        </figure>)}
      </div>
    </section>

    <section id="outcomes" class="outcomes-section wrap" aria-labelledby="outcomes-heading">
      <div class="stack outcomes-intro"><p class="eyebrow accent">04 — Outcomes</p><h2 id="outcomes-heading">Stopping is a destination too</h2><p class="section-intro">Wayfinding doesn't push anyone up a ladder. Its job is to make the choice clear. Each of these is the framework working as designed.</p></div>
      <div class="outcome-list">{outcomes.map((outcome) => <span>{outcome}</span>)}</div>
    </section>

    {showPrinciples && <section class="stance-section" aria-labelledby="stance-heading">
      <div class="wrap stance-grid">
        <div class="stack"><p class="eyebrow">05 — Stance</p><h2 id="stance-heading">Cardinal directions before the compass</h2><p class="body-copy">Strategy is the tools you use. Stance is how you position yourself to decide well as things change.</p></div>
        <ol>{principles.map((principle) => <li><span>{principle.n}</span><span>{principle.t}</span></li>)}</ol>
      </div>
    </section>}

    <section id="partners" class="partners-section wrap" aria-label="Partnering organisations">
      <p class="eyebrow accent">Partnering organisations</p>
      <div class="partner-grid">
        <a href="https://www.reset.tech/" class="partner-card"><span class="partner-logo"><img class="reset-logo" src="/partners/reset-logo.png" alt="Reset Tech logo" /></span><span class="partner-details"><span>Reset Tech</span><span>reset.tech ↗</span></span></a>
        <a href="https://aspirationtech.org/" class="partner-card"><span class="partner-logo"><img class="aspiration-logo" src="/partners/aspiration-logo.svg" alt="Aspiration logo" /></span><span class="partner-details"><span>Aspiration</span><span>aspirationtech.org ↗</span></span></a>
        <a href="https://hypha.group/" class="partner-card"><span class="partner-logo"><img class="hypha-logo" src="/partners/hypha-logo.png" alt="Hypha Group logo" /></span><span class="partner-details"><span>Hypha Group</span><span>hypha.group ↗</span></span></a>
      </div>
    </section>
  </main>
  <footer class="site-footer wrap">
    <span>Wayfinding is how you move when the destination is uncertain.</span>
    <nav aria-label="Footer"><a href="https://github.com/AI-Wayfinding/getting-started">Agent instructions</a><span>Facilitator guide</span><span>Improve Wayfinding</span></nav>
  </footer>

  <script>
    const button = document.querySelector<HTMLButtonElement>('#copy');
    const prompt = document.querySelector<HTMLElement>('#prompt')?.textContent ?? '';
    let copyTimer: ReturnType<typeof setTimeout>;
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt);
        button.textContent = 'Copied';
        clearTimeout(copyTimer);
        copyTimer = setTimeout(() => { button.textContent = 'Copy'; }, 1500);
      } catch { /* Clipboard unavailable: leave the label unchanged. */ }
    });

    const grid = document.querySelector<HTMLElement>('.voice-grid');
    if (grid) {
      const sets = JSON.parse(grid.dataset.voiceSets ?? '[]') as { color: string; items: { q: string; who: string }[] }[];
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.voice-card'));
      const indices = sets.map(() => 0);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let turn = 0;
      function advance(cardIndex: number) {
        const card = cards[cardIndex];
        const set = sets[cardIndex];
        const quote = card?.querySelector<HTMLElement>('.voice-quote');
        if (!card || !set || !quote || quote.classList.contains('fading')) return;
        const swap = () => {
          indices[cardIndex] = (indices[cardIndex] + 1) % set.items.length;
          const item = set.items[indices[cardIndex]];
          const blockquote = quote.querySelector('blockquote');
          const credit = quote.querySelector('figcaption');
          if (blockquote) blockquote.textContent = `“${item.q}”`;
          if (credit) credit.textContent = item.who;
          card.querySelectorAll('.voice-dot').forEach((dot, index) => dot.classList.toggle('active', index === indices[cardIndex]));
          quote.classList.remove('fading');
        };
        if (reducedMotion.matches) swap();
        else {
          quote.classList.add('fading');
          window.setTimeout(swap, 450);
        }
      }
      cards.forEach((card, index) => {
        card.addEventListener('click', () => advance(index));
        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); advance(index); }
        });
      });
      let rotation: ReturnType<typeof setInterval> | undefined;
      function syncRotation() {
        if (rotation) clearInterval(rotation);
        if (!reducedMotion.matches) rotation = setInterval(() => { advance(turn % cards.length); turn++; }, 2600);
      }
      syncRotation();
      reducedMotion.addEventListener('change', syncRotation);
    }
  </script>
</Base>

<style>
  .wrap { max-width: 1200px; margin-inline: auto; padding-inline: 32px; }
  .panel { background: var(--paper-light); }
  .eyebrow { margin: 0; font: 400 13px/1.5 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .accent { color: var(--accent); }
  .stack { display: flex; flex-direction: column; gap: 20px; }
  h1, h2, h3, h4, p { margin-block: 0; }
  h1, h2, .facilitator-box h3 { font-family: var(--font-display); font-weight: 400; }
  h2 { font-size: clamp(40px, 5vw, 60px); line-height: 1; }
  .body-copy, .section-intro { color: var(--muted); line-height: 1.6; text-wrap: pretty; }
  .body-copy { font-size: 17px; }
  .section-intro { font-size: 18px; }

  .site-header { padding-block: 22px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand img { display: block; }
  .brand span { font: 28px/1 var(--font-display); }
  .site-header nav { display: flex; gap: 28px; flex-wrap: wrap; font-size: 15px; }
  .site-header nav a { text-decoration: none; }
  .site-header nav .nav-start { color: var(--accent); font-weight: 500; }
  .spectrum { display: flex; height: 3px; }
  .spectrum span { flex: 1; }
  .spectrum span:nth-child(1) { background: var(--spectrum-red); }
  .spectrum span:nth-child(2) { background: var(--spectrum-orange); }
  .spectrum span:nth-child(3) { background: var(--spectrum-yellow); }
  .spectrum span:nth-child(4) { background: var(--spectrum-green); }
  .spectrum span:nth-child(5) { background: var(--spectrum-teal); }
  .spectrum span:nth-child(6) { background: var(--spectrum-blue); }
  .spectrum span:nth-child(7) { background: var(--spectrum-indigo); }
  .spectrum span:nth-child(8) { background: var(--spectrum-purple); }

  .hero { padding-block: 96px 88px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 56px; align-items: end; }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
  .hero-eyebrow::before { content: ''; width: 28px; height: 1px; background: var(--ink); }
  .hero h1 { font-size: clamp(52px, 7.4vw, 124px); line-height: .92; letter-spacing: -.02em; }
  .hero h1 em { white-space: nowrap; }
  .hero-copy { display: flex; flex-direction: column; gap: 28px; padding-bottom: 12px; }
  .hero-lede { font-size: 22px; line-height: 1.45; text-wrap: pretty; }
  .button-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .button { display: inline-block; padding: 14px 22px; font-size: 16px; font-weight: 500; text-decoration: none; }
  .button-primary { background: var(--ink); color: var(--paper); }
  .button-primary:hover { background: var(--accent); color: var(--paper); }
  .button-outline { padding: 13px 22px; border: 1px solid var(--ink); }
  .button-outline:hover { border-color: var(--accent); }

  .not-strip { border-bottom: 1px solid var(--ink); }
  .not-items { display: flex; align-items: baseline; gap: 16px 40px; flex-wrap: wrap; padding-block: 28px; }
  .not-items > span:not(.eyebrow) { font: 30px/1.1 var(--font-display); }

  .start-section { border-bottom: 1px solid var(--ink); }
  .start-grid { padding-block: 88px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 56px; }
  .benefits { display: flex; flex-direction: column; gap: 12px; margin: 8px 0 0; padding: 0; list-style: none; font-size: 16px; line-height: 1.5; }
  .benefits li { display: flex; gap: 12px; }
  .benefits li span { color: var(--accent); font-family: var(--font-mono); }
  .prompt-box { display: flex; flex-direction: column; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); min-width: 0; }
  .prompt-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid #3A4E6B; font: 13px var(--font-mono); }
  .prompt-head button { border: 0; background: var(--paper); color: var(--ink); padding: 6px 14px; font: inherit; cursor: pointer; }
  .prompt-head button:hover { background: var(--accent); color: var(--paper); }
  .prompt-box pre { margin: 0; padding: 24px 20px 28px; font: 15px/1.65 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  .prompt-box > a { margin-top: auto; padding: 12px 16px; border-top: 1px solid #3A4E6B; color: var(--paper); font: 13px var(--font-mono); }
  .prompt-box > a:hover { color: var(--accent-on-navy); }
  .facilitator-wrap { padding-bottom: 88px; }
  .facilitator-box { border: 1px solid var(--ink); background: var(--paper); padding: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px 48px; align-items: center; }
  .small-stack { gap: 12px; }
  .facilitator-box h3 { font-size: 40px; line-height: 1.05; }
  .facilitator-copy { gap: 18px; align-items: flex-start; }

  .triangle-section { padding-block: 104px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 64px; align-items: center; }
  .dimensions { border-top: 1px solid var(--ink); margin-top: 12px; }
  .dimensions > div { display: grid; grid-template-columns: 40px 1fr; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--hairline); }
  .dimensions > div > span { font-family: var(--font-mono); color: var(--accent); }
  .dimensions h3 { margin-bottom: 4px; font-size: 17px; font-weight: 600; }
  .dimensions p { color: var(--muted); font-size: 15px; line-height: 1.5; }
  .triangle-diagram { position: relative; aspect-ratio: 1 / .92; max-width: 520px; width: 100%; justify-self: center; margin-block: 35px; }
  .triangle-diagram svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .triangle-diagram > span { position: absolute; font: 24px var(--font-display); }
  .triangle-diagram .point-a { top: -4px; left: 50%; transform: translate(-50%, -100%); white-space: nowrap; }
  .triangle-diagram .point-c { right: 0; bottom: -4px; transform: translateY(100%); }
  .triangle-diagram .point-b { left: 0; bottom: -4px; transform: translateY(100%); }
  .triangle-diagram .point-balance { top: 66%; left: 50%; transform: translateX(-50%); color: var(--accent); font: 12px var(--font-mono); white-space: nowrap; }

  .exercise-section { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .exercise-content { padding-block: 96px; display: flex; flex-direction: column; gap: 72px; }
  .split-heading { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .split-heading .stack { max-width: 680px; }
  .split-heading > p { max-width: 400px; }
  .mode-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); border-left: 1px solid var(--ink); border-top: 1px solid var(--ink); }
  .mode-card { display: flex; flex-direction: column; gap: 14px; padding: 28px 24px 32px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--paper); }
  .mode-number { font: 56px/1 var(--font-display); color: var(--accent); }
  .mode-card h3 { font-size: 20px; font-weight: 600; }
  .mode-card > p { color: var(--muted); font-size: 15.5px; line-height: 1.55; text-wrap: pretty; }
  .mode-card .mode-form { margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--dash); color: var(--ink); font: 12.5px/1.5 var(--font-mono); }
  .process-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 48px; }
  .process-block { display: flex; flex-direction: column; gap: 20px; }
  .process-block .eyebrow { font-weight: 400; }
  .loop-grid { display: flex; flex-wrap: wrap; border: 1px solid var(--ink); }
  .loop-grid > div { flex: 1 1 140px; padding: 20px; border-right: 1px solid var(--ink); display: flex; flex-direction: column; gap: 8px; background: #fff; }
  .loop-grid > div:last-child { border-right: 0; }
  .loop-grid h4 { font: 30px/1 var(--font-display); }
  .loop-grid p { font-size: 14.5px; line-height: 1.5; color: var(--muted); }
  .process-note { color: var(--muted); font-size: 15px; line-height: 1.55; }
  .stage-list { border-top: 1px solid var(--ink); }
  .stage { display: grid; grid-template-columns: 44px 1fr; gap: 12px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--hairline); }
  .stage > span { color: var(--accent); font: 13px var(--font-mono); }
  .stage h4 { margin-bottom: 4px; font: 28px/1.1 var(--font-display); }
  .stage p { color: var(--muted); font-size: 15px; line-height: 1.5; }

  .voices-section { padding-top: 104px; display: flex; flex-direction: column; gap: 48px; }
  .voices-intro { max-width: 680px; }
  .voice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
  .voice-card { min-width: 0; min-height: 320px; margin: 0; padding: 28px 24px; display: flex; flex-direction: column; gap: 20px; cursor: pointer; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--paper-light); }
  .voice-card:hover { background: #fff; }
  .voice-card:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .voice-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .voice-tag { font: 12px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .voice-dots { display: flex; gap: 6px; }
  .voice-dot { width: 8px; height: 8px; border-radius: 50%; border: 1px solid currentColor; }
  .voice-dot.active { background: currentColor; }
  .voice-card:nth-child(1) .voice-top { color: var(--quote-tension); }
  .voice-card:nth-child(2) .voice-top { color: var(--quote-boundary); }
  .voice-card:nth-child(3) .voice-top { color: var(--quote-challenge); }
  .voice-card:nth-child(4) .voice-top { color: var(--quote-learning); }
  .voice-card:nth-child(5) .voice-top { color: var(--quote-practice); }
  .voice-card:nth-child(6) .voice-top { color: var(--quote-success); }
  .voice-quote { display: flex; flex: 1; flex-direction: column; gap: 20px; opacity: 1; transition: opacity 450ms ease; }
  .voice-quote.fading { opacity: 0; }
  .voice-quote blockquote { margin: 0; font: 28px/1.2 var(--font-display); text-wrap: pretty; }
  .voice-quote figcaption { margin-top: auto; font-size: 14px; color: var(--muted); }

